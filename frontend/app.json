{
  "expo": {
    "name": "Hara Hisaab",
    "slug": "nurserypos",
    "owner": "shashank_jindal",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nurserypos",
    "userInterfaceStyle": "light",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0ff8f95c-6822-4a2e-83d7-38bf03e117f6"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.planteck.nurserypos",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan plants and invoices to bill faster",
        "NSPhotoLibraryUsageDescription": "Add product photos from your gallery"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon-monochrome.png",
        "backgroundColor": "#1B5E3B"
      },
      "package": "com.planteck.nurserypos",
      "versionCode": 2,
      "permissions": ["android.permission.CAMERA"],
      "blockedPermissions": ["android.permission.RECORD_AUDIO"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#1B5E3B"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Scan plants and invoices to bill faster",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Add product photos from your gallery"
        }
      ],
      "expo-font",
      "expo-localization",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0ff8f95c-6822-4a2e-83d7-38bf03e117f6"
      }
    }
  }
}
