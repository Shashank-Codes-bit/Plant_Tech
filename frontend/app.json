{
  "expo": {
    "name": "NurseryPOS",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.phototopay.hlg2nq",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan plants and invoices to bill faster",
        "NSPhotoLibraryUsageDescription": "Add product photos from your gallery"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1B4D3E"
      },
      "package": "com.emergent.phototopay.hlg2nq",
      "permissions": ["android.permission.CAMERA"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1B4D3E"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Scan plants and invoices to bill faster"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Add product photos from your gallery"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
