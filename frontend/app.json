{
  "expo": {
    "name": "NurseryPOS",
    "slug": "nurserypos",
    "owner": "shashank_jindal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nurserypos",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.planteck.nurserypos",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan plants and invoices to bill faster",
        "NSPhotoLibraryUsageDescription": "Add product photos from your gallery"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1B4D3E"
      },
      "package": "com.planteck.nurserypos",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1B4D3E"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Scan plants and invoices to bill faster"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Add product photos from your gallery"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0ff8f95c-6822-4a2e-83d7-38bf03e117f6"
      }
    }
  }
}
