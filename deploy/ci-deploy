#!/usr/bin/env bash
# Forced command for the GitHub Actions deploy key. Install once on the VM:
#   install -m 755 deploy/ci-deploy ~/bin/nurserypos-ci-deploy
# and in ~/.ssh/authorized_keys:
#   command="/home/ubuntu/bin/nurserypos-ci-deploy",no-pty,no-port-forwarding,no-agent-forwarding,no-X11-forwarding ssh-ed25519 AAAA... nurserypos-deploy
# The key can only ask for "staging" or "prod"; it never gets a shell.
set -euo pipefail
case "${SSH_ORIGINAL_COMMAND:-}" in
  staging) exec "$HOME/Plant_Tech-staging/deploy/deploy.sh" staging ;;
  prod)    exec "$HOME/Plant_Tech/deploy/deploy.sh" prod ;;
  *) echo "refused: this key can only run 'staging' or 'prod'" >&2; exit 1 ;;
esac
