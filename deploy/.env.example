# Copy to deploy/.env on the VM and fill in. Never commit the real .env.

# MongoDB: MONGO_URL is set in compose.yaml; only the database name here
DB_NAME=nurserypos

# Claude API - https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_EFFORT_PLANT=low
CLAUDE_EFFORT_INVOICE=medium

# Signs login tokens. At least 32 random characters: openssl rand -hex 32
JWT_SECRET=

# Public address of this server (used in the bill links sent on WhatsApp)
PUBLIC_BASE_URL=https://nurserypos.140-238-251-141.sslip.io

# Google sign-in (owners): comma-separated OAuth client IDs (web + Android). Empty = Google button off.
GOOGLE_CLIENT_IDS=

# App admins (manage the shared picture library): comma-separated phone numbers
ADMIN_PHONES=

# AI scans allowed per shop per day
AI_DAILY_LIMIT=300

# Staging only: PROJECT_NAME=nurserypos-staging, HOST_PORT=8130, STORAGE_PREFIX=nurserypos-staging

# Photo storage: "r2" (Cloudflare R2) or "local" (VM disk, /data/uploads)
STORAGE_BACKEND=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=nurserypos-photos
